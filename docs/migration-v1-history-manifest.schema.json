{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.local/schema/v1-governance-history-migration-manifest.json",
  "title": "Collab v1 governance history migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "migration_id",
    "source_project_id",
    "canonical_project_cwd",
    "source_schema_version",
    "target_schema_version",
    "source_snapshot_digest",
    "target_epoch",
    "mapping_status",
    "records",
    "source_repo",
    "source_branch",
    "source_head",
    "source_tree",
    "archive_ref",
    "archive_digest",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "migration_id": {"type": "string", "minLength": 1},
    "source_project_id": {"type": "string", "minLength": 1},
    "canonical_project_cwd": {"type": "string", "minLength": 1},
    "source_repo": {"type": ["string", "null"]},
    "source_branch": {"type": ["string", "null"]},
    "source_head": {"type": ["string", "null"]},
    "source_tree": {"type": ["string", "null"]},
    "source_schema_version": {"type": "string", "minLength": 1},
    "target_schema_version": {"type": "string", "minLength": 1},
    "source_snapshot_digest": {"type": "string", "minLength": 1},
    "target_epoch": {"type": "string", "minLength": 1},
    "mapping_status": {
      "enum": ["planned", "running", "verified", "needs_operator", "reset_required", "aborted"]
    },
    "archive_ref": {"type": ["string", "null"]},
    "archive_digest": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_record_id",
          "source_record_type",
          "source_record_digest",
          "mapping_class",
          "mapping_status",
          "target_epoch"
        ],
        "properties": {
          "source_record_id": {"type": "string", "minLength": 1},
          "source_record_type": {"type": "string", "minLength": 1},
          "source_record_digest": {"type": "string", "minLength": 1},
          "target_epoch": {"type": "string", "minLength": 1},
          "target_sequence": {"type": ["integer", "null"], "minimum": 0},
          "target_entity_id": {"type": ["string", "null"]},
          "agent_id": {"type": ["string", "null"]},
          "runtime_id": {"type": ["string", "null"]},
          "binding_id": {"type": ["string", "null"]},
          "endpoint_generation": {"type": ["integer", "null"], "minimum": 0},
          "appsdk_record_ref": {"type": ["string", "null"]},
          "appsdk_record_digest": {"type": ["string", "null"]},
          "mapping_class": {"enum": ["direct", "adapt", "reset", "unknown"]},
          "mapping_status": {
            "enum": ["mapped", "needs_reconciliation", "blocked", "rejected", "unknown"]
          },
          "raw_archive_ref": {"type": ["string", "null"]},
          "exact_error": {"type": ["string", "null"]},
          "first_failed_boundary": {"type": ["string", "null"]},
          "created_at": {"type": "string", "minLength": 1},
          "updated_at": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "required": ["mapping_status"],
              "properties": {"mapping_status": {"const": "mapped"}}
            },
            "then": {
              "required": ["target_sequence", "target_entity_id"],
              "properties": {
                "target_sequence": {"type": "integer", "minimum": 0},
                "target_entity_id": {"type": "string", "minLength": 1}
              },
              "not": {
                "properties": {"mapping_class": {"const": "unknown"}}
              }
            }
          },
          {
            "if": {
              "required": ["mapping_class"],
              "properties": {"mapping_class": {"const": "unknown"}}
            },
            "then": {
              "required": ["exact_error", "first_failed_boundary"],
              "properties": {
                "exact_error": {"type": "string", "minLength": 1},
                "first_failed_boundary": {"type": "string", "minLength": 1}
              },
              "not": {
                "properties": {"mapping_status": {"const": "mapped"}}
              }
            }
          },
          {
            "if": {
              "required": ["mapping_class"],
              "properties": {"mapping_class": {"const": "reset"}}
            },
            "then": {
              "required": ["raw_archive_ref", "exact_error", "first_failed_boundary"],
              "properties": {
                "raw_archive_ref": {"type": "string", "minLength": 1},
                "exact_error": {"type": "string", "minLength": 1},
                "first_failed_boundary": {"type": "string", "minLength": 1}
              }
            }
          },
          {
            "if": {
              "required": ["mapping_status"],
              "properties": {"mapping_status": {"enum": ["blocked", "rejected", "unknown"]}}
            },
            "then": {
              "required": ["exact_error", "first_failed_boundary"],
              "properties": {
                "exact_error": {"type": "string", "minLength": 1},
                "first_failed_boundary": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["mapping_status"],
        "properties": {"mapping_status": {"const": "verified"}}
      },
      "then": {
        "required": ["archive_ref", "archive_digest", "source_repo"],
        "properties": {
          "archive_ref": {"type": "string", "minLength": 1},
          "archive_digest": {"type": "string", "minLength": 1},
          "source_repo": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "required": ["mapping_status"],
        "properties": {"mapping_status": {"const": "reset_required"}}
      },
      "then": {
        "required": ["archive_ref", "archive_digest"],
        "properties": {
          "archive_ref": {"type": "string", "minLength": 1},
          "archive_digest": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
