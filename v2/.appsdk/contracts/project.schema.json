{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/project.schema.json",
  "type": "object",
  "required": ["schema_version", "project_id", "sdk", "lifecycle", "access", "development_scenarios", "governance", "modules"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "sdk": {"type": "object", "required": ["name", "version", "bundle_manifest", "resource_record"], "properties": {"name": {"const": "appsdk"}, "version": {"type": "string"}, "bundle_manifest": {"const": ".appsdk/contracts/sdk-bundle.manifest.json"}, "resource_record": {"const": ".appsdk/sdk-resources.json"}}},
    "lifecycle": {"type": "object", "required": ["stage"], "properties": {"stage": {"type": "string"}}},
    "access": {"type": "object", "required": ["protected_paths"], "properties": {"protected_paths": {"type": "array", "items": {"type": "string"}}}},
    "development_scenarios": {"type": "object", "required": ["manifest", "enabled"], "properties": {"manifest": {"const": ".appsdk/contracts/development-scenarios.manifest.json"}, "enabled": {"type": "array", "uniqueItems": true, "items": {"enum": ["multi_worker_collaboration", "multi_worktree_merge_queue"]}}}},
    "governance": {"type": "object", "required": ["playground_root", "active_root", "protected_root", "generated_root", "active_kind", "protected_kinds", "generated_kinds", "freeze_requirements", "promotion_requires", "runtime_forbidden_roots", "record_contracts", "zone_transition_contract", "playground_retention", "debug_merge_comment_required"], "properties": {"playground_root": {"type": "string"}, "active_root": {"type": "string"}, "protected_root": {"type": "string"}, "generated_root": {"type": "string"}, "active_kind": {"const": "immutable_consumable_library"}, "protected_kinds": {"type": "array", "items": {"type": "string"}}, "generated_kinds": {"type": "array", "items": {"type": "string"}}, "freeze_requirements": {"type": "array", "items": {"type": "string"}}, "promotion_requires": {"type": "array", "items": {"type": "string"}}, "runtime_forbidden_roots": {"type": "array", "items": {"type": "string"}}, "record_contracts": {"type": "array", "items": {"type": "string"}}, "zone_transition_contract": {"type": "string"}, "playground_retention": {"enum": ["archive_then_remove", "archive_only"]}, "debug_merge_comment_required": {"const": true}}},
    "modules": {"type": "array", "items": {"type": "object", "required": ["module_id", "stage", "owned_paths", "source_owner", "active_artifact", "generated_outputs", "contract_paths", "dependency_modules", "build", "artifact_paths", "regression"], "properties": {"module_id": {"type": "string"}, "stage": {"type": "string"}, "owned_paths": {"type": "array", "items": {"type": "string"}}, "source_owner": {"type": "string"}, "active_artifact": {"type": "string"}, "generated_outputs": {"type": "array", "items": {"type": "string"}}, "contract_paths": {"type": "array", "items": {"type": "string"}}, "dependency_modules": {"type": "array", "items": {"type": "string"}}, "build": {"type": "object", "required": ["program", "args", "working_directory"], "properties": {"program": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}, "working_directory": {"type": "string"}}}, "artifact_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "version_base": {"type": "object", "required": ["previous_active_version", "new_active_version", "base_artifact_hash", "base_source_commit"], "properties": {"previous_active_version": {"type": "string"}, "new_active_version": {"type": "string"}, "base_artifact_hash": {"type": "string"}, "base_source_commit": {"type": "string"}}}, "regression": {"type": "object", "required": ["required_before_freeze", "suite_id", "command", "input_paths", "minimum_test_count", "allow_skipped", "ordinary_mode_after_freeze", "reenable_on"], "properties": {"required_before_freeze": {"type": "boolean"}, "suite_id": {"type": "string"}, "command": {"type": "object", "required": ["program", "args", "working_directory"], "properties": {"program": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}, "working_directory": {"type": "string"}}}, "input_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "minimum_test_count": {"type": "integer", "minimum": 1}, "allow_skipped": {"type": "boolean"}, "ordinary_mode_after_freeze": {"const": "disabled"}, "reenable_on": {"type": "array", "items": {"enum": ["source_change", "contract_change", "public_api_change", "artifact_change", "dependency_change"]}}}}}}},
    "lifecycles": {"type": "object", "required": ["issue", "library", "source_snapshot", "artifact"], "properties": {"issue": {"type": "string"}, "library": {"type": "string"}, "source_snapshot": {"type": "string"}, "artifact": {"type": "string"}}}
  }
}
