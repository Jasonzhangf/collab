{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/effectiveness-record.schema.json",
  "type": "object",
  "required": ["effectiveness_id", "issue_id", "module_id", "fix_candidate_id", "architecture_review_id", "reviewed_commit", "reviewed_tree_hash", "reproduction_input_hashes", "baseline_evidence_id", "fixed_replay_evidence_id", "positive_evidence_ids", "negative_evidence_ids", "blackbox_evidence_ids", "source_unchanged_since_review", "result", "created_at"],
  "properties": {
    "effectiveness_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "module_id": {"type": "string"},
    "fix_candidate_id": {"type": "string"},
    "architecture_review_id": {"type": "string"},
    "reviewed_commit": {"type": "string"},
    "reviewed_tree_hash": {"type": "string"},
    "reproduction_input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "baseline_evidence_id": {"type": "string"},
    "fixed_replay_evidence_id": {"type": "string"},
    "positive_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "negative_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "blackbox_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_unchanged_since_review": {"const": true},
    "result": {"const": "pass"},
    "created_at": {"type": "string"}
  }
}
