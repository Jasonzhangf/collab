{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/integration-record.schema.json",
  "type": "object",
  "required": ["integration_id", "queue_entry_id", "milestone_id", "issue_id", "module_id", "candidate_commit", "main_base_commit", "integration_commit", "integration_tree_hash", "conflict_status", "resolution_mode", "impact_status", "required_gate_results", "result", "created_at"],
  "properties": {
    "integration_id": {"type": "string"},
    "queue_entry_id": {"type": "string"},
    "milestone_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "module_id": {"type": "string"},
    "candidate_commit": {"type": "string"},
    "main_base_commit": {"type": "string"},
    "integration_commit": {"type": "string"},
    "integration_tree_hash": {"type": "string"},
    "conflict_status": {"const": "clean"},
    "resolution_mode": {"const": "none"},
    "impact_status": {"enum": ["unchanged", "revalidated"]},
    "required_gate_results": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["gate_id", "result", "producer", "source_commit", "tree_hash"], "properties": {"gate_id": {"type": "string"}, "result": {"const": "pass"}, "producer": {"type": "string"}, "source_commit": {"type": "string"}, "tree_hash": {"type": "string"}}}},
    "result": {"const": "pass"},
    "created_at": {"type": "string"}
  }
}
