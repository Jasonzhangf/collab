{
  "schema_version": 1,
  "resources": [
    {"resource_id":"project_contract","owner":"appsdk::project_contract","truth_store":".appsdk/project.json","allowed_operations":["read","validate","write"]},
    {"resource_id":"sdk_bundle","owner":"appsdk::delivery","truth_store":"running binary + embedded Bundle manifest/resources","allowed_operations":["read","validate"]},
    {"resource_id":"installed_sdk_resources","owner":"appsdk::delivery","truth_store":".appsdk/{contracts,docs,rules,skills}/**","allowed_operations":["read","validate","write"],"relations":{"must_reference":["sdk_bundle"]}},
    {"resource_id":"sdk_lock","owner":"appsdk::delivery","truth_store":".appsdk/sdk.lock","allowed_operations":["read","validate","write"],"relations":{"must_reference":["project_contract","sdk_bundle","installed_sdk_resources"]}},
    {"resource_id":"canonical_governance_maps","owner":"appsdk::architecture","truth_store":".appsdk/maps/{resource,function,mainline-call,verification}-map.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["sdk_bundle"]}},
    {"resource_id":"historical_governance_maps","owner":"appsdk::delivery","truth_store":".appsdk/migrations/0.1.5-to-0.1.6/maps/**","allowed_operations":["read","validate","write"],"relations":{"must_reference":["project_contract","sdk_bundle"]}},
    {"resource_id":"sdk_migration_record","owner":"appsdk::delivery","truth_store":".appsdk/migrations/0.1.5-to-0.1.6/record.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["project_contract","sdk_bundle","canonical_governance_maps","historical_governance_maps"]}},
    {"resource_id":"lifecycle_records","owner":"appsdk::record_graph","truth_store":".appsdk/records/**","allowed_operations":["read","validate","write"]},
    {"resource_id":"compiled_artifact","owner":"appsdk::compiler","truth_store":"generated/project.compiled.json","allowed_operations":["read","write"]},
    {"resource_id":"frozen_generated_projection","owner":"appsdk::lifecycle","truth_store":"generated/modules/<module>/**","allowed_operations":["read","validate","write"],"relations":{"must_reference":["lifecycle_records"]}},
    {"resource_id":"protected_archive","owner":"appsdk::lifecycle","truth_store":"protected/history/<module>/**","allowed_operations":["read","validate","write"],"relations":{"must_reference":["frozen_generated_projection","lifecycle_records"]}},
    {"resource_id":"protected_version_archive","owner":"appsdk::lifecycle","truth_store":"protected/history-versions/<module>/<version>/**","allowed_operations":["read","validate","write"],"relations":{"must_reference":["lifecycle_records"]}},
    {"resource_id":"active_library","owner":"appsdk::lifecycle","truth_store":"active/lib/<module>/**","allowed_operations":["read","validate","write"],"relations":{"must_reference":["protected_archive","frozen_generated_projection","lifecycle_records"]}},
    {"resource_id":"frozen_rehydrate_transaction","owner":"appsdk::lifecycle","truth_store":".appsdk/transactions/rehydrate-<module>/marker.json","allowed_operations":["read","validate","write","remove"],"relations":{"must_reference":["lifecycle_records","frozen_generated_projection","protected_archive","active_library"]},"forbidden_relations":["unowned_active_projection","hash_mismatched_projection"]},
    {"resource_id":"fix_worktree","owner":"appsdk::fix_lifecycle","truth_store":".appsdk/records/worktree-record-<module>.json","allowed_operations":["read","validate","write"]},
    {"resource_id":"fix_evidence_set","owner":"appsdk::fix_lifecycle","truth_store":".appsdk/records/evidence/<module>/<evidence_id>.json","allowed_operations":["read","validate","write"]},
    {"resource_id":"fix_candidate","owner":"appsdk::fix_lifecycle","truth_store":".appsdk/records/fix-candidate-record-<module>.json","allowed_operations":["read","validate","write"]},
    {"resource_id":"pre_review_validation","owner":"appsdk::verification","truth_store":".appsdk/records/pre-review-validation-record-<module>.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["fix_candidate","compiled_artifact","fix_evidence_set"]}},
    {"resource_id":"architecture_review","owner":"appsdk::fix_lifecycle","truth_store":".appsdk/records/review-record-<module>.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["fix_candidate","pre_review_validation","fix_evidence_set"]}},
    {"resource_id":"fix_effectiveness","owner":"appsdk::fix_lifecycle","truth_store":".appsdk/records/effectiveness-record-<module>.json","allowed_operations":["read","validate","write"]},
    {"resource_id":"development_scenarios","owner":"appsdk::development_scenarios","truth_store":".appsdk/contracts/development-scenarios.manifest.json","allowed_operations":["read","validate"]},
    {"resource_id":"worker_collaboration","owner":"appsdk::collaboration","truth_store":".appsdk/records/collaboration-record-<collaboration_id>.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["fix_worktree","collaboration_index"]}},
    {"resource_id":"collaboration_index","owner":"appsdk::collaboration","truth_store":".appsdk/records/collaboration-index.json","allowed_operations":["read","validate","write"],"forbidden_relations":["duplicate_semantic_claim","duplicate_worker","duplicate_worktree"]},
    {"resource_id":"merge_queue","owner":"appsdk::merge_queue","truth_store":".appsdk/records/merge-queue-record-<queue_entry_id>.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["worker_collaboration","merge_queue_state"]}},
    {"resource_id":"merge_queue_state","owner":"appsdk::merge_queue","truth_store":".appsdk/records/merge-queue-state.json","allowed_operations":["read","validate","write"],"forbidden_relations":["multiple_merge_owners","duplicate_queue_entry"]},
    {"resource_id":"integration_candidate","owner":"appsdk::merge_queue","truth_store":".appsdk/records/integration-record-<integration_id>.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["merge_queue"]}},
    {"resource_id":"mainline_receipt","owner":"appsdk::host_vcs","truth_store":".appsdk/records/mainline-receipt-record-<receipt_id>.json","allowed_operations":["read","validate","write"],"relations":{"must_reference":["integration_candidate","remote_repository"]}},
    {"resource_id":"remote_repository","owner":"appsdk::host_vcs","truth_store":"git ls-remote <remote> <ref>","allowed_operations":["observe"]},
    {"resource_id":"remote_tracking_ref","owner":"appsdk::host_vcs","truth_store":"refs/remotes/<remote>/<recorded-mainline-ref>","allowed_operations":["read","validate"],"relations":{"must_reference":["mainline_merge"]}},
    {"resource_id":"mainline_merge","owner":"appsdk::merge_queue","truth_store":".appsdk/records/merge-record-<module>.json","allowed_operations":["read","validate","write"]},
    {"resource_id":"lifecycle_error","owner":"appsdk::record_graph","truth_store":"process error chain","allowed_operations":["emit"]}
  ]
}
