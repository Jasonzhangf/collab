{
  "schema_version": 1,
  "gates":[
    {"gate_id":"contract_valid","command":"appsdk verify <project>","required_for":["compile","promotion","freeze"]},
    {"gate_id":"sdk_source_registry","command":"appsdk verify-sdk-source-registry <sdk-repo>","required_for":["build","release"]},
    {"gate_id":"sdk_migration","command":"cargo test --test cli_smoke pin_lock_migrates_only_supported_sdk_and_matching_bundle_binary","required_for":["sdk_upgrade","release"]},
    {"gate_id":"governance_map_migration","command":"cargo test --test cli_smoke pin_lock_migrates_only_supported_sdk_and_matching_bundle_binary","required_for":["sdk_upgrade","historical_review","release"]},
    {"gate_id":"portable_mainline_ref","command":"cargo test --test cli_smoke rehydrate_frozen_rebuilds_fresh_checkout_projections","required_for":["fresh_checkout","record_graph"]},
    {"gate_id":"sdk_pinned","command":"appsdk pin-lock <project> --binary <sdk>","required_for":["compile","promotion","freeze"]},
    {"gate_id":"record_graph","command":"appsdk verify <project>","required_for":["architecture_stable","freeze","publish"]},
    {"gate_id":"frozen_rehydrate","command":"cargo test --test cli_smoke rehydrate_frozen_rebuilds_fresh_checkout_projections","required_for":["fresh_checkout","begin_version"]},
    {"gate_id":"rehydrate_transaction_recovery","command":"cargo test --test cli_smoke rehydrate_frozen_rebuilds_fresh_checkout_projections","required_for":["fresh_checkout","post_publish_recovery","release"]},
    {"gate_id":"vcs_clean","command":"appsdk verify <project>","required_for":["freeze"]},
    {"gate_id":"regression_report","command":"appsdk verify <project>","required_for":["freeze","frozen_integrity"]},
    {"gate_id":"worktree_clean","command":"appsdk verify <project>","required_for":["reproduction","fix_candidate"]},
    {"gate_id":"baseline_reproduced","command":"appsdk verify <project>","required_for":["fix_candidate"]},
    {"gate_id":"fix_candidate_verified","command":"appsdk verify <project>","required_for":["architecture_review"]},
    {"gate_id":"development_whitebox","producer":"project::whitebox_adapter","command":"appsdk verify --review-admission <project> --module <id>","human_contract":"project adapter executes whitebox and writes development_whitebox EvidenceRecord before admission","required_for":["pre_review_validation"]},
    {"gate_id":"deployment_receipts","producer":"project::deployment_adapter","command":"appsdk verify --review-admission <project> --module <id>","human_contract":"project adapter installs and restarts exact artifact and writes deployment receipt EvidenceRecords before admission","required_for":["deployed_blackbox_effectiveness","pre_review_validation"]},
    {"gate_id":"deployed_blackbox_effectiveness","producer":"project::blackbox_adapter","command":"appsdk verify --review-admission <project> --module <id>","human_contract":"project adapter executes deployed public-entrypoint blackbox and writes deployed_blackbox EvidenceRecord before admission","required_for":["pre_review_validation"]},
    {"gate_id":"pre_review_validation","command":"appsdk verify --review-admission <project> --module <id>","required_for":["architecture_review","commit","merge_admission"]},
    {"gate_id":"architecture_review_pass","command":"appsdk verify <project>","required_for":["architecture_stable","effectiveness"]},
    {"gate_id":"post_architecture_effectiveness","command":"appsdk verify <project>","required_for":["merge_admission"]},
    {"gate_id":"scenario_pair_activation","command":"appsdk verify <project>","required_for":["multi_worker_collaboration","multi_worktree_merge_queue"]},
    {"gate_id":"exclusive_worker_worktree","command":"appsdk verify <project>","required_for":["merge_queue_admission"]},
    {"gate_id":"incremental_milestone_delivery","command":"appsdk verify <project>","required_for":["merge_queue_admission","next_milestone_start"]},
    {"gate_id":"serial_merge_queue","command":"appsdk verify <project>","required_for":["integration_build"]},
    {"gate_id":"integration_affected_verification","producer":"appsdk::verifier","command":"appsdk verify <project>","required_for":["integration_verification"]},
    {"gate_id":"tested_integration_identity","command":"appsdk verify <project>","required_for":["mainline_merge"]},
    {"gate_id":"remote_main_receipt","command":"appsdk verify <project>","required_for":["promotion","cleanup","freeze","publish"]},
    {"gate_id":"mainline_merge_identity","command":"appsdk verify <project>","required_for":["promotion","compile","freeze","publish"]},
    {"gate_id":"fix_lifecycle_graph","command":"appsdk verify <project>","required_for":["promotion","freeze","publish"]}
  ]
}
