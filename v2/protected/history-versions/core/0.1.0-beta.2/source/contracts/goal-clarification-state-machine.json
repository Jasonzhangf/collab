{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/goal-clarification-state-machine.json",
  "initial": "received",
  "states": ["received", "parsed", "clarification_pending", "confirmed", "admitted", "superseded"],
  "transitions": [
    {"from":"received","to":"parsed","requirements":["raw_request","understood_objective"]},
    {"from":"parsed","to":"clarification_pending","requirements":["ambiguities_or_questions"]},
    {"from":"parsed","to":"confirmed","requirements":["no_open_questions","acceptance_criteria","non_goals"]},
    {"from":"clarification_pending","to":"confirmed","requirements":["all_questions_answered","acceptance_criteria","scope"]},
    {"from":"confirmed","to":"admitted","requirements":["claim","owner","required_gates"]}
  ]
}
