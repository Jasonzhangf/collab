{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/lifecycle-state-machines.json",
  "type": "object",
  "required": ["issue", "library", "source_snapshot", "artifact"],
  "properties": {
    "issue": {"$ref": "#/$defs/state_machine"},
    "library": {"$ref": "#/$defs/state_machine"},
    "source_snapshot": {"$ref": "#/$defs/state_machine"},
    "artifact": {"$ref": "#/$defs/state_machine"}
  },
  "$defs": {
    "state_machine": {
      "type": "object",
      "required": ["initial", "states", "transitions"],
      "properties": {
        "initial": {"type": "string"},
        "states": {"type": "array", "items": {"type": "string"}},
        "transitions": {"type": "array", "items": {"type": "object", "required": ["from", "to", "requirements"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "requirements": {"type": "array", "items": {"type": "string"}}}}}
      }
    }
  }
}
