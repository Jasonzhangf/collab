{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/goal-clarification-record.schema.json",
  "type": "object",
  "required": ["goal_id", "raw_request", "understood_objective", "acceptance_criteria", "non_goals", "assumptions", "ambiguities", "questions", "status", "created_at"],
  "properties": {
    "goal_id": {"type": "string"},
    "issue_id": {"type": ["string", "null"]},
    "raw_request": {"type": "string", "minLength": 1},
    "understood_objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "ambiguities": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "object", "required": ["question_id", "question", "status"], "properties": {"question_id": {"type": "string"}, "question": {"type": "string"}, "answer": {"type": ["string", "null"]}, "status": {"enum": ["open", "answered", "not_required"]}}}},
    "scope": {"type": "object", "properties": {"feature_id": {"type": "string"}, "module_id": {"type": "string"}, "resource_ids": {"type": "array", "items": {"type": "string"}}, "allowed_paths": {"type": "array", "items": {"type": "string"}}, "forbidden_paths": {"type": "array", "items": {"type": "string"}}}},
    "risk_decisions": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["received", "parsed", "clarification_pending", "confirmed", "admitted", "superseded"]},
    "confirmed_by": {"type": ["string", "null"]},
    "confirmed_at": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  }
}
