{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/collaboration-record.schema.json",
  "type": "object",
  "required": ["collaboration_id", "issue_id", "module_id", "scenario_ids", "run_id", "semantic_claim_id", "worker_id", "worktree_id", "milestone_id", "parent_task_id", "milestone_sequence", "predecessor_collaboration_id", "predecessor_receipt_id", "milestone_scope", "independently_verifiable", "one_milestone_per_worktree", "exclusive_worktree", "exclusive_claim", "status", "created_at"],
  "properties": {
    "collaboration_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "module_id": {"type": "string"},
    "scenario_ids": {"const": ["multi_worker_collaboration", "multi_worktree_merge_queue"]},
    "run_id": {"type": "string"},
    "semantic_claim_id": {"type": "string"},
    "worker_id": {"type": "string"},
    "worktree_id": {"type": "string"},
    "milestone_id": {"type": "string"},
    "parent_task_id": {"type": "string"},
    "milestone_sequence": {"type": "integer", "minimum": 1},
    "predecessor_collaboration_id": {"type": "string"},
    "predecessor_receipt_id": {"type": "string"},
    "milestone_scope": {"type": "string"},
    "independently_verifiable": {"const": true},
    "one_milestone_per_worktree": {"const": true},
    "exclusive_worktree": {"const": true},
    "exclusive_claim": {"const": true},
    "status": {"const": "handoff_ready"},
    "created_at": {"type": "string"}
  }
}
