{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/promotion-record.schema.json",
  "type": "object",
  "required": ["promotion_id", "issue_id", "experiment_id", "module_id", "worktree_record_id", "reproduction_record_id", "fix_candidate_id", "architecture_review_id", "effectiveness_record_id", "merge_record_id", "base_commit", "candidate_commit", "merged_commit", "source_commit", "previous_active_version", "new_active_version", "review_id", "evidence_ids", "required_gate_results", "change_set_id", "compatibility_level", "root_cause", "design_id", "change_reason_comment", "playground_cleanup_record_id", "created_at"],
  "properties": {
    "promotion_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "module_id": {"type": "string"},
    "worktree_record_id": {"type": "string"},
    "reproduction_record_id": {"type": "string"},
    "fix_candidate_id": {"type": "string"},
    "architecture_review_id": {"type": "string"},
    "effectiveness_record_id": {"type": "string"},
    "merge_record_id": {"type": "string"},
    "collaboration_record_id": {"type": "string"},
    "merge_queue_record_id": {"type": "string"},
    "integration_record_id": {"type": "string"},
    "mainline_receipt_record_id": {"type": "string"},
    "base_commit": {"type": "string"},
    "candidate_commit": {"type": "string"},
    "merged_commit": {"type": "string"},
    "source_commit": {"type": "string"},
    "previous_active_version": {"type": ["string", "null"]},
    "new_active_version": {"type": "string"},
    "base_artifact_hash": {"type": ["string", "null"]},
    "artifact_hash": {"type": "string"},
    "scope_hash": {"type": "string"},
    "public_api_hash": {"type": "string"},
    "review_id": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "required_gate_results": {"type": "array", "items": {"type": "object", "required": ["gate_id", "result", "producer"], "properties": {"gate_id": {"type": "string"}, "result": {"enum": ["pass", "fail"]}, "producer": {"type": "string"}}}},
    "change_set_id": {"type": "string"},
    "migration_id": {"type": ["string", "null"]},
    "compatibility_level": {"enum": ["compatible", "migration_required", "breaking"]},
    "root_cause": {"type": "string"},
    "design_id": {"type": "string"},
    "change_reason_comment": {"type": "string"},
    "playground_cleanup_record_id": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
