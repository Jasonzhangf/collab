{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/pre-review-validation-record.schema.json",
  "type": "object",
  "required": ["validation_id", "issue_id", "module_id", "fix_candidate_id", "candidate_commit", "candidate_tree_hash", "artifact_hash", "whitebox_producer", "whitebox_evidence_ids", "blackbox_evidence_ids", "deployment", "source_unchanged", "result", "created_at"],
  "properties": {
    "validation_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "module_id": {"type": "string"},
    "fix_candidate_id": {"type": "string"},
    "candidate_commit": {"type": "string"},
    "candidate_tree_hash": {"type": "string"},
    "artifact_hash": {"type": "string"},
    "whitebox_producer": {"type": "object", "required": ["adapter", "identity"], "properties": {"adapter": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}}},
    "whitebox_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "blackbox_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "deployment": {"type": "object", "required": ["environment_id", "install_receipt_id", "restart_receipt_id", "entrypoint", "producer", "observed_at"], "properties": {"environment_id": {"type": "string", "minLength": 1}, "install_receipt_id": {"type": "string", "minLength": 1}, "restart_receipt_id": {"type": "string", "minLength": 1}, "entrypoint": {"type": "string", "minLength": 1}, "producer": {"type": "object", "required": ["adapter", "identity"], "properties": {"adapter": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}}}, "observed_at": {"type": "string", "format": "date-time"}}},
    "source_unchanged": {"const": true},
    "result": {"const": "pass"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
