{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/reproduction-record.schema.json",
  "type": "object",
  "required": ["reproduction_id", "issue_id", "module_id", "worktree_id", "base_commit", "input_hashes", "baseline_evidence_id", "first_divergence", "result", "created_at"],
  "properties": {
    "reproduction_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "module_id": {"type": "string"},
    "worktree_id": {"type": "string"},
    "base_commit": {"type": "string"},
    "input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "baseline_evidence_id": {"type": "string"},
    "first_divergence": {"type": "string"},
    "result": {"const": "reproduced"},
    "created_at": {"type": "string"}
  }
}
