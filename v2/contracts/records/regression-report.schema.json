{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/regression-report.schema.json",
  "type": "object",
  "required": ["regression_report_id", "module_id", "source_commit", "artifact_hash", "public_api_hash", "scope_hash", "input_hash", "suite_id", "command", "test_count", "passed", "failed", "skipped", "result", "producer", "test_characteristics", "created_at"],
  "properties": {
    "regression_report_id": {"type": "string"},
    "module_id": {"type": "string"},
    "source_commit": {"type": "string"},
    "artifact_hash": {"type": "string"},
    "public_api_hash": {"type": "string"},
    "scope_hash": {"type": "string"},
    "input_hash": {"type": "string"},
    "suite_id": {"type": "string"},
    "command": {
      "type": "object",
      "required": ["program", "args", "working_directory"],
      "properties": {
        "program": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string"}
      }
    },
    "test_count": {"type": "integer", "minimum": 1},
    "passed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "skipped": {"type": "integer", "minimum": 0},
    "result": {"const": "pass"},
    "producer": {
      "type": "object",
      "required": ["adapter", "identity"],
      "properties": {
        "adapter": {"type": "string"},
        "identity": {"type": "string"}
      }
    },
    "test_characteristics": {
      "type": "object",
      "required": ["whitebox", "blackbox"],
      "properties": {
        "whitebox": {"const": true, "description": "regression must use whitebox (internal state/behavior inspection)"},
        "blackbox": {"const": true, "description": "regression must also use blackbox (external interface, input/output contracts)"}
      }
    },
    "created_at": {"type": "string"}
  }
}
